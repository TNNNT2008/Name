local function C_3()
local script = G2L["3"];
	
	local SEARCH_WORD = "side"
	local textspam = true
	local doorhghtlight = true
	local otherhighlight = true
	local keyhighlight = true
	local hidehighlight = true
	
	local function changecolor(val, button)
		if val == true then
			button.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		else
			button.BackgroundColor3 = Color3.fromRGB(64, 0, 255)
		end
		val = not val
		return val
	end
	
	for i, button in pairs(script.Parent:WaitForChild("ScrollingFrame"):GetDescendants()) do
		if button.Name == "Other" then
			button.MouseButton1Click:Connect(function()
				otherhighlight = changecolor(otherhighlight, button)
			end)
		elseif button.Name == "Keys" then
			button.MouseButton1Click:Connect(function()
				keyhighlight = changecolor(keyhighlight, button)
			end)
		elseif button.Name == "Hides" then
			button.MouseButton1Click:Connect(function()
				hidehighlight = changecolor(hidehighlight, button)
			end)
		elseif button.Name == "Doors" then
			button.MouseButton1Click:Connect(function()
				doorhghtlight = changecolor(doorhghtlight, button)
			end)
		elseif button.Name == "Text" then
			button.MouseButton1Click:Connect(function()
				textspam = changecolor(textspam, button)
			end)
		end
	end
	
	
	local List = game.Players.LocalPlayer.PlayerGui.Kaka.Frame
	local cool = List.Frame
	local tweenService = game:GetService("TweenService")
	local tweenInfo = TweenInfo.new(0.3 , Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
	
	local function playtween(image, name, description)
		local clone = cool:Clone()
		clone.Parent = List
		clone.Size = UDim2.new(0, 0,0.12, 0)
		clone.Image.Image = image
		clone.N.Text = name
		clone.D.Text = description
		local tween = tweenService:Create(clone, tweenInfo, {Size = UDim2.new(1, 0,0.12, 0)})
		local tween2 = tweenService:Create(clone, tweenInfo, {Size = UDim2.new(0, 0,0.12, 0)})
		clone.Visible = true
		tween:Play()
		task.wait(5)
		tween2:Play()
		task.wait(0.3)
		clone:Destroy()
	end
	
	
	local function highlight(object, color)
		if not object:FindFirstChild("Highlight") then
			local hl = Instance.new("Highlight")
			hl.FillColor = color
			hl.OutlineTransparency = 0.8
			hl.Parent = object
		end
	end
	
	workspace.ChildAdded:Connect(function(child)
		if not textspam then return end
		if child.Name == "RushMoving" then
			task.spawn(playtween, "rbxassetid://10892995976", "Rush", "Направляется в вашу сторону")	
		elseif child.Name == "Eyes" then
			task.spawn(playtween, "rbxassetid://10865377903", "Glaza", "Находятся в этой комнате")
		elseif child.Name == "AmbushMoving" then
			task.spawn(playtween, "rbxassetid://10722835155", "Ambush", "Направляeтся в вашу сторону")
		elseif child.Name == "MonumentEntity" then
			highlight(child, Color3.fromRGB(255, 0, 4))
		end
	end)
	
	task.spawn(function()
		while task.wait(1.5) do 
	
	
			local currentRooms = workspace:FindFirstChild("CurrentRooms")
			if not currentRooms then continue end
	
	
			local rooms = currentRooms:GetChildren()
			for _, room in ipairs(rooms) do
	
	
				if not room or not room:IsDescendantOf(workspace) then continue end
	
	
				local name = room.Name
	
				local door = room:FindFirstChild("Door")
	
				if door and room.Name ~= "50" and doorhghtlight == true then
	
					local collisionPart = door:FindFirstChild("Collision")
					if collisionPart and collisionPart.CanCollide == true then
						highlight(door, Color3.fromRGB(255, 0, 0))
					else
						highlight(door, Color3.fromRGB(30, 0, 255)) 
					end
				end 
	
				local succes, err = pcall(function()
					if room.Name == "50" and room:FindFirstChild("FigureSetup") then
						local assets = room:FindFirstChild("Assets")
						local shelves = assets and assets:FindFirstChild("Bookshelves1")
	
	
						local figureSetup = room:FindFirstChild("FigureSetup")
						local figure = figureSetup and figureSetup:FindFirstChild("FigureRig")
						if figure and not figure:FindFirstChild("Highlight") then
							highlight(figure, Color3.fromRGB(255, 0, 0)) 
						end
	
						if shelves then
							for _, shelf in ipairs(shelves:GetChildren()) do
								local book = shelf:FindFirstChild("LiveHintBook")
								if book and not book:FindFirstChild("Highlight") then
									highlight(book, Color3.fromRGB(76, 52, 255)) 
								end
							end
						end
					end
				end)
				
				-- tut budet dispenser
				for _, dauni in pairs(room:GetChildren()) do
					if dauni.Name == "Groundskeeper" and not dauni:FindFirstChild("Highlight") then
						highlight(dauni, Color3.fromRGB(255, 0, 0))
					elseif dauni.Name == "Snares" and not dauni:FindFirstChild("Highlight") then
						highlight(dauni, Color3.fromRGB(255, 0, 0))
					elseif dauni.Name == "Mandrakes" and dauni:FindFirstChild("MandrakeLive") then
						highlight(dauni.MandrakeLive, Color3.fromRGB(255, 0, 0))
					end
				end
	
				local assetsFolder = room:FindFirstChild("Assets")
	
	
				if assetsFolder then
					for _, asset in ipairs(assetsFolder:GetChildren()) do
						local ward = asset:FindFirstChild("DrawerContainer")
	
						for _, subAsset2 in ipairs(asset:GetDescendants()) do
							if subAsset2 and subAsset2.Name == "KeyObtain" and keyhighlight == true and not subAsset2.Parent.Name == "DrawerContainer" and not subAsset2.Parent.Name == "Table" then
								highlight(subAsset2, Color3.fromRGB(30, 0, 255))
							end
						end
	
						if asset.Name == "Wardrobe" and hidehighlight == true then
							highlight(asset, Color3.fromRGB(0, 255, 21))
						elseif asset.Name == "Toolshed" and hidehighlight == true then
							highlight(asset, Color3.fromRGB(0, 255, 21))
						elseif asset:FindFirstChild("GoldPile") and not asset:FindFirstChild("KeyObtain") or asset:FindFirstChild("IronKeyForCrypt") and otherhighlight == true then
							highlight(asset.GoldPile, Color3.fromRGB(255, 170, 0))
						elseif asset:FindFirstChild("KeyObtain") and keyhighlight == true then
							highlight(asset.KeyObtain, Color3.fromRGB(30, 0, 255))
						elseif asset:FindFirstChild("LotusHolder") then
							highlight(asset, Color3.fromRGB(184, 4, 169))
						elseif ward then
							local success = false
							local content = asset:GetDescendants()
							for i, babaka in ipairs(content) do
								if babaka.Name == "KeyObtain" or babaka.Name == "IronKeyForCrypt" and keyhighlight == true then success = true end
								if success then
									success = true
									highlight(asset, Color3.fromRGB(30, 0, 255))
									break
								end
							end
							if success ~= true then
								highlight(asset, Color3.fromRGB(255, 0, 0))
							end
						elseif asset.Name == "KeyObtain" and keyhighlight == true then
							highlight(asset, Color3.fromRGB(30, 0, 255))
						elseif asset:FindFirstChild("Bandage") and otherhighlight == true then
							highlight(asset.Bandage, Color3.fromRGB(255, 0, 0))
						elseif asset:FindFirstChild("LeverForGate") and otherhighlight == true then
							highlight(asset, Color3.fromRGB(255, 0, 0))
						elseif asset.Name == "Bed" and hidehighlight == true then
							highlight(asset, Color3.fromRGB(0, 255, 21))
						elseif asset.Name == "LeverForGate" and otherhighlight == true then
							highlight(asset, Color3.fromRGB(255, 0, 0))
						elseif asset:FindFirstChild("Smoothie") and otherhighlight == true then
							highlight(asset.Smoothie, Color3.fromRGB(255, 0, 0))
	
	
	
	
						elseif string.find(string.lower(asset.Name), SEARCH_WORD) then
	
							local subAssets = asset:FindFirstChild("Assets") or asset
	
							for _, subAsset in ipairs(subAssets:GetChildren()) do
								if subAsset.Name == "Wardrobe" and hidehighlight == true then
									highlight(subAsset, Color3.fromRGB(0, 255, 21))
								elseif subAsset.Name == "Toolshed" and hidehighlight == true then
									highlight(subAsset, Color3.fromRGB(0, 255, 21))
								elseif subAsset.Name == "Bed" and hidehighlight == true then
									highlight(subAsset, Color3.fromRGB(0, 255, 21))
								elseif subAsset:FindFirstChild("KeyObtain") and keyhighlight == true then
									highlight(subAsset.KeyObtain, Color3.fromRGB(30, 0, 255))
								elseif subAsset:FindFirstChild("DrawerContainer") and otherhighlight == true then
									highlight(subAsset, Color3.fromRGB(255, 0, 0))
								elseif subAsset.Name == "ChestBoxLocked" and otherhighlight == true then
									highlight(subAsset, Color3.fromRGB(255, 170, 0))
								elseif subAsset.Name == "ChestBox" and otherhighlight == true then
									highlight(subAsset, Color3.fromRGB(255, 170, 0))
								end
							end
						end
	
					end
				end
				for i, this in ipairs(room:GetChildren()) do
					if string.find(string.lower(this.Name), SEARCH_WORD) then
						local subAssets = this:FindFirstChild("Assets") or this 
						for _, subAsset in ipairs(subAssets:GetChildren()) do
							if subAsset.Name == "Wardrobe" and hidehighlight == true then
								highlight(subAsset, Color3.fromRGB(0, 255, 21))
							elseif subAsset.Name == "Toolshed" and hidehighlight == true then
								highlight(subAsset, Color3.fromRGB(0, 255, 21))
							elseif subAsset:FindFirstChild("KeyObtain") and keyhighlight == true then
								highlight(subAsset.KeyObtain, Color3.fromRGB(30, 0, 255))
							elseif subAsset.Name == "Bed" and hidehighlight == true then
								highlight(subAsset, Color3.fromRGB(0, 255, 21))
							elseif subAsset:FindFirstChild("DrawerContainer") and otherhighlight == true then
								highlight(subAsset, Color3.fromRGB(255, 0, 0))
							elseif subAsset.Name == "ChestBoxLocked" and otherhighlight == true then
								highlight(subAsset, Color3.fromRGB(255, 170, 0))
							elseif subAsset.Name == "ChestBox" and otherhighlight == true then
								highlight(subAsset, Color3.fromRGB(255, 170, 0))
							elseif subAsset.Name == "KeyObtain" and keyhighlight == true then
								highlight(subAsset, Color3.fromRGB(30, 0, 255))
							end
						end
					end
				end
			end
		end
	end)
end;
task.spawn(C_3);
